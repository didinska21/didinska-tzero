# Copy to .env and fill in. NEVER commit .env, never paste the key in chat.
PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_WALLET_KEY

# Base Sepolia
RPC_URL=https://sepolia.base.org
API_BASE=https://testnet.tzer0.fun

# Safety: keep true until you have reviewed the dry-run logs.
DRY_RUN=true

# Backing strategy (Fuel + Crew)
BUY_AMOUNT_ETH=0.01
MIN_PROGRESS_BPS=9000
MIN_HOLDERS=3
MAX_BUYS_PER_DAY=3
SLIPPAGE_BPS=1000
MIN_BALANCE_ETH=0.005
GAS_RESERVE_ETH=0.002

# $T0 staking (Staking points come from earned rewards)
STAKE_T0=true
CLAIM_REWARDS=true

# Optional: launch your own mission (Liftoff points still need 5 OTHER
# wallets backing it with >= 0.01 ETH each, held 60 min)
LAUNCH_ENABLED=false
LAUNCH_NAME=
LAUNCH_SYMBOL=
LAUNCH_URI=

# Loop rhythm
LOOP_INTERVAL_SEC=900
JITTER_SEC=180
